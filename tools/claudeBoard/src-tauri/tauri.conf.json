{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claudeBoard",
  "version": "0.1.0",
  "identifier": "com.moringchen.claude-board",
  "build": {
    "beforeDevCommand": "sh -c 'curl --noproxy \"*\" --silent --fail http://localhost:1420/ > /dev/null || npm run dev & npm run dev:ensure-daemon && until curl --noproxy \"*\" --silent --fail http://127.0.0.1:46123/snapshot > /dev/null; do sleep 1; done'",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "claudeBoard",
        "width": 260,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": false,
        "transparent": true,
        "skipTaskbar": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
