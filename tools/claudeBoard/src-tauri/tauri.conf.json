{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claudeBoard",
  "version": "0.1.0",
  "identifier": "com.moringchen.claude-board",
  "build": {
    "beforeDevCommand": "sh -c 'curl --noproxy \"*\" --silent --fail http://localhost:1420/ > /dev/null || npm run dev'",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "claudeBoard",
        "width": 420,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
