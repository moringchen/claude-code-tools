{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Task Window",
  "version": "0.1.0",
  "identifier": "com.moringchen.claude-task-window",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Task Window",
        "width": 420,
        "height": 88,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true
      }
    ]
  }
}
